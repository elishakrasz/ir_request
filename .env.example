# Engagement Dashboard — environment variables.
# Copy to `.env` and fill in. Never commit the real .env.
#
# The Entra app is SHARED with prospect_pipeline (operator decision 2026-07-28):
# same TENANT_ID / CLIENT_ID / CLIENT_SECRET values. Rotating the secret affects
# both projects.

# ── Microsoft Entra app (Graph app-only Mail.Read + Dataverse) ────────────────
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# ── Dataverse ─────────────────────────────────────────────────────────────────
# DEV ONLY. Deliberately no PROD URL in this file — house rule 1: PROD is never
# touched by code; solution import to PROD is a manual maker-portal step.
DATAVERSE_URL=

# Publisher prefix for the new schema (e.g. new_)
PREFIX=new_

# ── Ingestion scope ───────────────────────────────────────────────────────────
# Internal email domains, comma-separated (direction classification)
ORG_DOMAINS=exigentcap.com

# Explicit mailbox list, comma-separated — never auto-enumerate all users
MAILBOXES=
